# Ramis ERP — Geliştirme ortamı
# ---------------------------------------------------------------------------
# Tam referans: docs/wiki/Backend_Environment.md
# Üretim şablonu: backend/.env.production.example → /etc/ramis/backend.env
#
# settings.py başlangıcında otomatik yüklenir (.env varsa üzerine yazar).
# Sunucuyu LAN'dan dinlemek için:
#   cd backend && python manage.py runserver 0.0.0.0:8000
# ---------------------------------------------------------------------------

# --- Temel ---
DJANGO_DEBUG=true
# Geliştirmede settings.py içindeki varsayılan insecure anahtar kullanılır.
# İsterseniz override edin: DJANGO_SECRET_KEY=

# Mobil garson / LAN erişimi — makine IP'nizi ALLOWED_HOSTS'a ekleyin
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.10

# Next.js (varsayılan port 3000) + LAN
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.10:3000
CORS_EXTRA_ORIGINS=http://192.168.0.10:3000

# --- Veritabanı ---
# POSTGRES_* tanımlı değilse SQLite (backend/db.sqlite3) kullanılır.
# POSTGRES_DB=ramis
# POSTGRES_USER=ramis
# POSTGRES_PASSWORD=ramis
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Redis (WebSocket / Channels / Celery) ---
# Tanımlı değilse InMemoryChannelLayer + LocMemCache (tek süreç; WS sınırlı).
# KDS, garson push, Celery için Redis önerilir:
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# REDIS_CHANNELS_URL=redis://127.0.0.1:6379/2
# REDIS_LOCK_URL=redis://127.0.0.1:6379/1

# --- WebSocket / performans (isteğe bağlı) ---
# WS_AUTH_CACHE_SECONDS=60
# WS_KDS_STATS_THROTTLE_SECONDS=2
# CHANNEL_LAYER_CAPACITY=8000
# CHANNEL_LAYER_EXPIRY=120

# --- İş kuralları (isteğe bağlı) ---
# STOCK_RESERVATION_ENABLED=true
# ENABLE_SMART_FIRING_V2=false
# SMART_FIRING_UI_BUSY_THRESHOLD=15
# PRINT_THERMAL_SYNC=true

# --- Celery Beat (isteğe bağlı; varsayılanlar settings ile aynı) ---
# BEAT_CLEANUP_RESERVATIONS_HOUR=3
# BEAT_CLEANUP_RESERVATIONS_MINUTE=0
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_HOUR=3
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_MINUTE=15
# PRINTER_STATUS_SYNC_INTERVAL_MINUTES=5
# BEAT_SCAN_KITCHEN_LOW_STOCK_HOUR=4
# BEAT_SCAN_KITCHEN_LOW_STOCK_MINUTE=0
# BEAT_SCAN_OVERDUE_PO_HOUR=5
# BEAT_SCAN_OVERDUE_PO_MINUTE=0
# BEAT_SCAN_EXPIRING_LOTS_HOUR=4
# BEAT_SCAN_EXPIRING_LOTS_MINUTE=30
# BEAT_SWEEP_STALE_CLEANING_TABLES_INTERVAL_MINUTES=1
# BEAT_NOTIFY_DUE_RESERVATIONS_INTERVAL_MINUTES=1
