# Kopyalayın: copy .env.example .env  (veya ortam değişkenlerini shell’de export edin)
#
# Tam referans (tüm anahtarlar, ölçeklendirme, servis yeniden başlatma):
#   docs/wiki/Backend_Environment.md
# Üretim şablonu: backend/.env.production.example → /etc/ramis/backend.env

DJANGO_DEBUG=true
# Üretimde zorunlu, güçlü rastgele anahtar:
# DJANGO_SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF (cookie tabanlı API + Next.js): frontend kök URL'leri
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_EXTRA_ORIGINS=

# LAN geliştirme (Next.js "Network" URL): IP'yi ALLOWED_HOSTS'a ekleyin.
# DEBUG=true iken CSRF için http://<IP>:3000 otomatik türetilir; CORS RFC1918 regex ile açılır.
# Örnek:
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.50:3000
# CORS_EXTRA_ORIGINS=http://192.168.1.50:3000

# Token X-Connect Cloud webhook taban URL (ör. https://api.ornek.com)
# FISCAL_WEBHOOK_BASE_URL=https://api.ornek.com

# POSTGRES_DB=ramis
# POSTGRES_USER=ramis
# POSTGRES_PASSWORD=ramis
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Channels önbelleği + Django cache (Redis)
# REDIS_URL=redis://127.0.0.1:6379/0
# Varsayılan ayrım (REDIS_URL=/0): cache db/1, channels db/2, lock=cache
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# REDIS_CHANNELS_URL=redis://127.0.0.1:6379/2
# REDIS_LOCK_URL=redis://127.0.0.1:6379/1
# --- Celery Beat (Europe/Istanbul; değişiklik sonrası: manage.py sync_celery_beat_schedule) ---
# BEAT_CLEANUP_RESERVATIONS_HOUR=3
# BEAT_CLEANUP_RESERVATIONS_MINUTE=0
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_HOUR=3
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_MINUTE=15
# PRINTER_STATUS_SYNC_INTERVAL_MINUTES=5
# CELERY_PRINTING_WORKER_CONCURRENCY=4
# PRINT_JOB_REQUEUE_PENDING_SECONDS=45
# PRINT_JOB_STALE_PROCESSING_SECONDS=180
# PRINT_JOB_MAINTENANCE_INTERVAL_SECONDS=30
# PRINT_JOB_MAINTENANCE_BATCH_SIZE=100
# BEAT_SCAN_KITCHEN_LOW_STOCK_HOUR=4
# BEAT_SCAN_KITCHEN_LOW_STOCK_MINUTE=0
# BEAT_SCAN_OVERDUE_PO_HOUR=5
# BEAT_SCAN_OVERDUE_PO_MINUTE=0
# BEAT_SCAN_EXPIRING_LOTS_HOUR=4
# BEAT_SCAN_EXPIRING_LOTS_MINUTE=30
# BEAT_SWEEP_STALE_CLEANING_TABLES_INTERVAL_MINUTES=1
# BEAT_NOTIFY_DUE_RESERVATIONS_INTERVAL_MINUTES=1
# BEAT_REDIS_CLEANUP_HOUR=2
# BEAT_REDIS_CLEANUP_MINUTE=30
# BEAT_AUTO_CLOSE_TABLES_HOUR=2
# BEAT_AUTO_CLOSE_TABLES_MINUTE=0
# BEAT_PURGE_EXPIRED_86_ENABLED=false
# BEAT_PURGE_EXPIRED_86_HOUR=5
# BEAT_PURGE_EXPIRED_86_MINUTE=0
# DEFICIENCY_REPAIR_ENABLED=false
# BEAT_DEFICIENCY_REPAIR_HOUR=4
# BEAT_DEFICIENCY_REPAIR_MINUTE=45
# DEFICIENCY_REPAIR_MIN_AGE_HOURS=24
# DEFICIENCY_REPAIR_ORDERED_ACTION=revert_to_approved
# DEFICIENCY_REPAIR_STALE_ENABLED=false
# DEFICIENCY_REPAIR_STALE_ACTION=cancel
# REDIS_MAINTENANCE_ENABLED=true
# REDIS_CELERY_RESULT_MAX_IDLE_SECONDS=3600
# CELERY_RESULT_EXPIRES_SECONDS=3600

# WS auth önbelleği (saniye) — yoğun reconnect'te DB yükünü azaltır
# WS_AUTH_CACHE_SECONDS=60
# KDS istatistik yayını throttle (saniye, şube başına)
# WS_KDS_STATS_THROTTLE_SECONDS=2
# KDS geri çağır drawer: servise gönderilmiş kalemlerin listede kalma süresi (dk, varsayılan 15)
# KDS_RECALL_WINDOW_MINUTES=15
# channels_redis kapasite / TTL (yoğun saatler)
# CHANNEL_LAYER_CAPACITY=8000
# CHANNEL_LAYER_EXPIRY=120
# Daphne ASGI süreç sayısı (nginx upstream; varsayılan 1)
# DAPHNE_INSTANCES=2
