# Ramis ERP — Üretim ortamı için örnek ortam dosyası
# ---------------------------------------------------------------------------
# Tam referans (tüm anahtarlar, ölçeklendirme, servis yeniden başlatma):
#   docs/wiki/Backend_Environment.md
# Kapasite testi env anahtarları: docs/wiki/Load_Testing.md
#
# Bu dosyayı repoya GERÇEK şifrelerle commit ETMEYİN.
# Sunucuda kopyalayın:  cp .env.production.example /etc/ramis/backend.env
# İzin: chmod 600 /etc/ramis/backend.env
#
# Django bu dosyayı OTOMATİK OKUMAZ. Yükleme seçenekleri:
#   • systemd: EnvironmentFile=/etc/ramis/backend.env
#   • Manuel:  set -a && source /path/to/backend.env && set +a
#   • Shell:   export DJANGO_SECRET_KEY=... (tek tek)
# ---------------------------------------------------------------------------

# --- Zorunlu (DEBUG kapalıyken) ---
DJANGO_DEBUG=false

# openssl rand -hex 48  ile üretin; en az 50 karakter önerilir
DJANGO_SECRET_KEY=6223b317803a6ccbb185ee675a93f356812cfa083e1275f1af0eb1f4e1274bc188b769366dbfbd140b443eb5079e5f98

# API’nin kabul edeceği host’lar (virgülle, boşluksuz)
ALLOWED_HOSTS=api.ornek.com,127.0.0.1

# --- PostgreSQL (POSTGRES_DB tanımlı değilse SQLite kullanılır — üretimde PostgreSQL kullanın) ---
POSTGRES_DB=ramis
POSTGRES_USER=ramis
POSTGRES_PASSWORD=guclu-veritabani-sifresi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Split ASGI (Uvicorn+Daphne): varsayılan CONN_MAX_AGE=0; env'deki POSTGRES_CONN_MAX_AGE=60 bile yok sayılır.
# POSTGRES_CONN_MAX_AGE=0
# İstisna — split deploy'da kalıcı bağlantı (ileri seviye; max_connections riski): docs/wiki/ASGI_Split_Deploy.md
# RAMIS_DB_PERSISTENT_CONNECTIONS=true
# POSTGRES_CONN_MAX_AGE=60
# JWT kullanıcı önbelleği (sn) — her API isteğinde DB sorgusunu azaltır
# JWT_AUTH_CACHE_SECONDS=60

# --- Redis (WebSocket / Channels + cache — üretimde şiddetle önerilir) ---
# Uygulama ile aynı sunucuda: 127.0.0.1 kullanın (localhost → IPv6 gecikmesi/çözüm riski).
REDIS_URL=redis://127.0.0.1:6379/0
# Varsayılan türetim: broker=/0 (REDIS_URL), cache=/1, channels=/2, yazıcı kilidi=cache
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# REDIS_CHANNELS_URL=redis://127.0.0.1:6379/2
# REDIS_LOCK_URL=redis://127.0.0.1:6379/1
# REDIS_SOCKET_CONNECT_TIMEOUT=10
# REDIS_CHANNELS_SOCKET_TIMEOUT=30
# Yoğun KDS: kanal kuyruğu (channels_redis capacity) ve mesaj süresi (saniye)
# CHANNEL_LAYER_CAPACITY=8000
# CHANNEL_LAYER_EXPIRY=120
# WS auth önbelleği / KDS stats throttle (saniye)
# WS_AUTH_CACHE_SECONDS=60
# WS_KDS_STATS_THROTTLE_SECONDS=2
# Daphne ASGI süreç sayısı (1–4 önerilir; nginx least_conn)
# DAPHNE_INSTANCES=2

# --- Celery Beat (Europe/Istanbul; değişiklik sonrası sync_celery_beat_schedule) ---
# BEAT_CLEANUP_RESERVATIONS_HOUR=3
# BEAT_CLEANUP_RESERVATIONS_MINUTE=0
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_HOUR=3
# BEAT_ROLLUP_PRODUCT_STATION_TIMING_MINUTE=15
# PRINTER_STATUS_SYNC_INTERVAL_MINUTES=5
# BEAT_SCAN_KITCHEN_LOW_STOCK_HOUR=4
# BEAT_SCAN_KITCHEN_LOW_STOCK_MINUTE=0
# BEAT_SCAN_OVERDUE_PO_HOUR=5
# BEAT_SCAN_OVERDUE_PO_MINUTE=0
# BEAT_SCAN_EXPIRING_LOTS_HOUR=4
# BEAT_SCAN_EXPIRING_LOTS_MINUTE=30
# BEAT_SWEEP_STALE_CLEANING_TABLES_INTERVAL_MINUTES=1
# BEAT_NOTIFY_DUE_RESERVATIONS_INTERVAL_MINUTES=1
# BEAT_AUTO_CLOSE_TABLES_HOUR=2
# BEAT_AUTO_CLOSE_TABLES_MINUTE=0
# BEAT_PURGE_EXPIRED_86_ENABLED=false
# BEAT_PURGE_EXPIRED_86_HOUR=5
# BEAT_PURGE_EXPIRED_86_MINUTE=0

# --- Next.js farklı domain’deyse (ör. app.ornek.com → api.ornek.com) ---
# HTTPS ile tam kök URL, virgülle:
CSRF_TRUSTED_ORIGINS=https://app.ornek.com
CORS_EXTRA_ORIGINS=https://app.ornek.com

# Aynı domain üzerinden /api ile servis ediyorsanız yine de güvenilir origin’leri
# CSRF_TRUSTED_ORIGINS ve CORS_EXTRA_ORIGINS ile eşleştirin.

# --- HTTPS / güvenlik (nginx arkasında SSL sonlandırma) ---
# Ters vekil X-Forwarded-Proto: https göndermeli.
SECURE_SSL_REDIRECT=true
# SECURE_HSTS_PRELOAD=true

# --- İsteğe bağlı iş kuralları ---
# STOCK_RESERVATION_ENABLED=false
# JWT_REFRESH_TOKEN_DAYS=3
# SESSION_COOKIE_AGE_SECONDS=259200
# RBAC_CACHE_TTL=120
# POS_DISPLAY_WS_TOKEN_MAX_AGE=86400
# FISCAL_WEBHOOK_BASE_URL=https://api.ornek.com
# ENABLE_SMART_FIRING_V2=true
# SMART_FIRING_UI_BUSY_THRESHOLD=15
