# Ramis ERP — Frontend ortam değişkenleri
# Kopyalayın: cp .env.example .env.local
# Next.js build/dev sunucusu yeniden başlatılmalıdır.
#
# Tam referans (NEXT_PUBLIC_*, runtime config, rebuild gereksinimi):
#   docs/wiki/Frontend_Environment.md
# IP değişimi / rebuild gerektirmeyen API URL: docs/wiki/Runtime_Config.md
# Üretim dosyası: /etc/ramis/frontend.env
#
# Doğrulama: src/environments/clientPublicSchema.ts
# Staging pilot (EPIC-07 offline kuyruk): bkz. .env.staging.example

# ---------------------------------------------------------------------------
# API (zorunlu — production/staging build)
# ---------------------------------------------------------------------------
# Mutlaka /api/v1 ile bitmeli (cookie tabanlı JWT + CORS ile uyumlu origin).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# EPIC-07 — POS çevrimdışı işlem kuyruğu
# ---------------------------------------------------------------------------
# true  → IndexedDB kuyruk + otomatik senkron + uzlaşma ekranı
# false veya boş → klasik online-only POS (backend idempotency yine aktif)
NEXT_PUBLIC_POS_OFFLINE_QUEUE=false

# ---------------------------------------------------------------------------
# Opsiyonel
# ---------------------------------------------------------------------------
# Development'ta API interceptor toast'ları (production'da varsayılan kapalı)
# NEXT_PUBLIC_API_INTERCEPTOR_TOASTS=true

# LAN üzerinden dev (telefon/tablet): Next dev sunucusuna erişilen hostname/IP (virgülle ayrılmış)
# NEXT_PUBLIC_API_URL hostname'i otomatik eklenir; arayüz farklı IP'den açılıyorsa burayı kullanın.
# ALLOWED_DEV_ORIGINS=192.168.1.50
