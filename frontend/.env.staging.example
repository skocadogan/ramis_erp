# Ramis ERP — Staging pilot: POS offline kuyruk (EPIC-07)
#
# Frontend env referansı: docs/wiki/Frontend_Environment.md
#
# Kullanım:
#   cp .env.staging.example .env.local
#   # veya staging CI/CD secret store'a aynı anahtarları yazın
#   npm run build && npm run start
#
# Önkoşullar (backend):
#   python manage.py migrate orders   # PosIdempotencyRecord
#   CSRF_TRUSTED_ORIGINS / CORS → staging frontend origin'i ekli olmalı
#
# Not: Service Worker yalnızca production build'de aktif (Serwist).
#      Offline kuyruk IndexedDB ile dev/staging/prod'da çalışır.

# --- Staging API (örnek — kendi host'unuzla değiştirin) ---
NEXT_PUBLIC_API_URL=https://staging.ramis.example.com/api/v1

# --- Pilot: offline kuyruk AÇIK ---
NEXT_PUBLIC_POS_OFFLINE_QUEUE=true

# --- Staging'de operasyonel hata toast'ları (isteğe bağlı) ---
NEXT_PUBLIC_API_INTERCEPTOR_TOASTS=true

# ---------------------------------------------------------------------------
# Pilot doğrulama checklist (manuel)
# ---------------------------------------------------------------------------
# 1. POS'ta sipariş gönder → DevTools → Application → IndexedDB → ramis-pos-offline-v1
# 2. Network offline simüle et → sipariş/ödeme kuyruğa düşmeli (header rozeti)
# 3. Online ol → otomatik flush; uzlaşma dialog'unda kayıt kaybolmalı
# 4. Aynı işlem tekrar denendiğinde backend 409/200 already_processed (çift kayıt yok)
# 5. Vardiya kapatma: bekleyen kuyruk varsa Dialog uyarısı
